{
  "name": "rr-platform",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/backoffice/tsconfig.json",
    "build:packages": "tsc -p packages/domain/tsconfig.build.json && tsc -p packages/http/tsconfig.build.json && tsc -p packages/mailer/tsconfig.build.json && tsc -p packages/providers/tsconfig.build.json",
    "check": "npm run check -w @rr/pricing-api",
    "docs:vocabulario": "npm run docs:vocabulario -w @rr/pricing-api",
    "serve": "npm run serve -w @rr/pricing-api",
    "kapso:functions": "npm run deploy:functions -w @rr/kapso-agent",
    "kapso:workflow": "npm run deploy:workflow -w @rr/kapso-agent"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vercel/node": "^5",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
