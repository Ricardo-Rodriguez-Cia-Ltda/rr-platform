{
  "name": "rr-platform",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsx --env-file=.env.local scripts/check.ts",
    "docs:vocabulario": "tsx --env-file=.env.local scripts/docs-vocabulario.ts",
    "serve": "tsx --env-file=.env.local server.ts",
    "kapso:functions": "tsx --env-file=.env.local scripts/kapso-functions.ts",
    "kapso:workflow": "tsx --env-file=.env.local scripts/kapso-workflow-v2.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vercel/node": "^5",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
