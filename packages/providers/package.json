{
  "name": "@rr/providers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@rr/domain": "*"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
