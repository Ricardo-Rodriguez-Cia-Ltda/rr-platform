# Clave que el sistema consumidor manda en el header x-api-key
API_SECRET_KEY=changeme
# Solo para el servidor local: prefijo de ruta extra bajo el que se expone el
# endpoint (ademas de /api/price). Ej: /rr/captador-precios -> /rr/captador-precios/price
BASE_PATH=
# Carpeta donde se cachea el catalogo de cada proveedor (opcional; default cache/)
CATALOG_CACHE_DIR=

# --- Intcomex ---
# Clave publica de Intcomex (dev o prod segun entorno)
INTCOMEX_API_KEY=00000000-0000-0000-0000-000000000000
# Clave privada de Intcomex - NUNCA commitear el valor real
INTCOMEX_ACCESS_KEY=changeme
# test: https://intcomex-test.apigee.net/v1/  |  prod: https://intcomex-prod.apigee.net/v1/
INTCOMEX_BASE_URL=https://intcomex-test.apigee.net/v1/

# --- Tecnoglobal ---
# Usuario y clave que entrega su area TI. La clave llega YA hasheada en MD5:
# va tal cual, no se vuelve a hashear.
TECNOGLOBAL_USER=changeme
TECNOGLOBAL_PASSWORD=changeme
# Opcional; default http://200.6.78.34/stock/v1/
TECNOGLOBAL_BASE_URL=
# Opcional; vida util de la foto de precios en ms (default 540000 = 9 min).
# Tecnoglobal corta el acceso por cantidad de consultas en 10 minutos y no tiene
# consulta de precios por lote: subir esto de 10 min arriesga quedarse sin cuota.
TECNOGLOBAL_PRECIOS_TTL_MS=

# --- Ingram Micro ---
# Se generan creando una aplicacion en developer.ingrammicro.com
INGRAM_CLIENT_ID=
INGRAM_CLIENT_SECRET=
# Numero de cliente que Ingram asigna a la cuenta (header IM-CustomerNumber)
INGRAM_CUSTOMER_NUMBER=
# Opcional; codigo ISO de dos letras (default CL)
INGRAM_COUNTRY_CODE=
# Opcionales; default https://api.ingrammicro.com y .../oauth/oauth30/token
INGRAM_BASE_URL=
INGRAM_TOKEN_URL=
# Opcional; identificador nuestro que Ingram registra en sus logs
INGRAM_SENDER_ID=
# Opcional; tope de paginas del volcado de catalogo (default 500 = 50.000 productos)
INGRAM_MAX_PAGINAS=
